# Copy to .env.local (git-ignored) for local development. For EAS builds, set the
# same names as EAS environment variables (expo.dev → project → Environment variables).
#
# Both values are designed to be public (they ship inside the app); Row Level
# Security protects the data. NEVER put the service_role / secret key here or
# anywhere in the app or repository.

# Supabase → Project Settings → API → Project URL, e.g. https://abcdefghijklmnop.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API Keys → publishable key ("anon" key on older projects)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
