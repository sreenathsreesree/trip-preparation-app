# Copy to .env.local (git-ignored) for local development. For EAS builds, set the
# same names as EAS environment variables (expo.dev → project → Environment variables).
#
# Both values are designed to be public (they ship inside the app); Row Level
# Security protects the data. NEVER put the service_role / secret key here or
# anywhere in the app or repository.

# Trip Prep project (Supabase → Project Settings → API → Project URL). Not a secret.
EXPO_PUBLIC_SUPABASE_URL=https://okudcunrqusrzppqnppm.supabase.co

# Supabase → Project Settings → API Keys → publishable key (sb_publishable_…). Keep the real value
# out of this file: put it in .env.local or the EAS environment variable.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Places (place search, shared Google Maps links, Recommended nearby). NOT a secret: the https
# URL of Trip Prep's places proxy (server/places-proxy). The Google API key lives only in the proxy
# as a server secret — never here, never in the app. Leave empty to use free open map data instead.
EXPO_PUBLIC_PLACES_PROXY_URL=
