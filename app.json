{
  "expo": {
    "name": "Trip Prep",
    "slug": "sreedream-labs",
    "scheme": "tripprep",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#202832",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sreenathsreesree.tripprep"
    },
    "android": {
      "package": "com.sreenathsreesree.tripprep",
      "adaptiveIcon": {
        "backgroundColor": "#202832",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-sqlite",
      "expo-image",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Trip Prep uses your photo library so you can add pictures of your belongings.",
          "cameraPermission": "Trip Prep uses the camera so you can photograph your belongings.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#202832"
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "da7f0444-9f26-4e18-9fe6-89436ea04754"
      }
    },
    "owner": "sreedream-labs"
  }
}
