{
  "name": "trip-preparation-app",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.21",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.6",
    "@react-native/jest-preset": "^0.88.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cloud": "node --test --no-warnings supabase/tests/cloud.test.mjs supabase/tests/sharing.test.mjs supabase/tests/expenses.test.mjs supabase/tests/backup.test.mjs",
    "supabase:bundle": "node scripts/build-supabase-bundle.mjs",
    "supabase:verify": "node --no-warnings scripts/verify-supabase.mjs",
    "doctor": "npx expo-doctor",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:cloud",
    "build:web": "expo export --platform web --output-dir dist",
    "e2e:web": "node e2e/web-smoke.mjs",
    "e2e:inventory": "node e2e/web-inventory.mjs",
    "e2e:planner": "node e2e/web-planner.mjs",
    "e2e:planner-reliability": "node e2e/web-planner-reliability.mjs",
    "e2e:auth": "node e2e/web-auth.mjs",
    "e2e:packing": "node e2e/web-packing.mjs",
    "e2e:planner-dnd": "node e2e/web-planner-dnd.mjs",
    "e2e:destination": "node e2e/web-destination.mjs",
    "e2e:journal": "node e2e/web-journal.mjs",
    "e2e:sharing": "node e2e/web-sharing.mjs",
    "e2e:calculator": "node e2e/web-calculator.mjs",
    "build:android:dev": "npx eas-cli@latest build --platform android --profile development",
    "build:android:preview": "npx eas-cli@latest build --platform android --profile preview"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/",
      "/supabase/"
    ]
  }
}
